          "config/firstboot/moodecfg.ini")


def assemble(release_root: Path, dest: Path) -> Path:
    if dest.exists():
        shutil.rmtree(dest)
    dest.mkdir(parents=True)
    for target, source in SETUP_MAP:
        if target.endswith("/*"):
            (dest / target[:-2]).mkdir(parents=True, exist_ok=True)
            for src in sorted(release_root.glob(source)):
                shutil.copy2(src, dest / target[:-2] / src.name)
            continue
        src = release_root / source
        if src.is_dir():
            shutil.copytree(src, dest / target, dirs_exist_ok=True)
        elif src.is_file():
            (dest / target).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dest / target)
    missing = [n for n in NEEDED if not (dest / n).exists()]
    if missing:
        raise InstallError("this release cannot set up a new radio (it has no app/setup/: "
                           f"missing {', '.join(missing)}). Use a newer release or the build guide.")
    for sh in (dest / "scripts").iterdir():
        sh.chmod(0o755)
    return dest


# --- fetch: the whole verified download ---------------------------------------------------------

def fetch_release(base: str, channel: str, out: Path, root_pubs: list[str], now: float | None = None) -> dict:
    """Keyring -> index -> release.json -> tarball -> unpacked + setup tree, all verified.
    Returns {"version", "seq", "root", "setup", "trust", "release"}."""
    now = time.time() if now is None else now
    base = base.rstrip("/")
    allowed = {"https", urllib.parse.urlparse(base).scheme}
    if channel not in CHANNELS:
        raise InstallError(f"channel must be one of {', '.join(CHANNELS)}")
    out.mkdir(parents=True, exist_ok=True)
    kr, krs = get_small(f"{base}/keyring.json", allowed), get_small(f"{base}/keyring.json.sig", allowed)
    ring = verify_keyring(kr, krs, root_pubs, now)
    which = "the pinned Hasler root key" if root_pubs == [ROOT_PUB] else "the root key given with --root-pub"
    say(f"keyring {ring['keyring_seq']}: signed by {which}")
    try:
        idx = get_small(f"{base}/channels/{channel}.json", allowed)
    except InstallError as e:
        if "404" in str(e):
            raise InstallError(f"there is no {channel!r} channel yet at {base}"
                               + (" - try channel=bench" if channel == "stable" else "")) from e
        raise
    index = verify_index(idx, get_small(f"{base}/channels/{channel}.json.sig", allowed), ring, channel, now)
    cur = index["current"]
    say(f"channel {channel}: {cur['version']} (seq {cur['seq']}), index signed")
    rel_url = str(cur["release_url"])
    rel = get_small(rel_url, allowed)
    release = verify_release(rel, get_small(rel_url + ".sig", allowed), ring, index, now)
    art = release["artifacts"][0]
    say(f"release.json {release['version']}: signed; downloading {art['name']} ({int(art.get('size', 0)) >> 20} MB)")
    if not re.fullmatch(r"hasler-[0-9A-Za-z.+-]+\.tar(\.zst|\.gz)?", str(art["name"])):
        raise InstallError(f"release.json: odd artifact name {art['name']!r}")
    tarball = download(str(art["url"]), out / "dl" / art["name"], art["sha256"], art.get("size"), allowed)
    say("tarball: SHA-256 matches the signed release.json")
    root = unpack(tarball, out / "tree", release.get("files_sha256"))
    say(f"unpacked {root.name}: every file matches files.sha256")
    setup = assemble(root, out / "setup")
    trust = out / "trust"
    trust.mkdir(exist_ok=True)
    (trust / "root.pub").write_text("\n".join(root_pubs) + "\n")
    (trust / "keyring.json").write_bytes(kr)
    (trust / "keyring.json.sig").write_bytes(krs)
    (out / "release.json").write_bytes(rel)
    return {"version": release["version"], "seq": int(release["seq"]), "root": root, "setup": setup,
            "trust": trust, "release": release}


# --- settings ----------------------------------------------------------------------------

DEFAULTS = {"channel": "stable", "update_mode": "auto", "variant": "hasler-hm", "user": "",
            "moode": "yes", "panel_optional": "no", "update_url": ""}


def read_settings(path: Path) -> dict:
    """hasler.txt: ``key = value`` lines, # comments. Unknown keys are refused, so
    a typo is not silently ignored."""
    out = dict(DEFAULTS)
    if not path.exists():
        return out
    for n, raw in enumerate(path.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if "=" not in line:
            raise InstallError(f"{path}:{n}: expected key = value")
        k, v = (s.strip().strip('"').strip("'") for s in line.split("=", 1))
        k = k.lower()
        if k not in DEFAULTS:
            raise InstallError(f"{path}:{n}: unknown setting {k!r} (known: {', '.join(DEFAULTS)})")
        out[k] = v
    return validate(out)


def validate(s: dict) -> dict:
    if s["channel"] not in CHANNELS:
        raise InstallError(f"channel must be stable or bench, not {s['channel']!r}")
    if s["update_mode"] not in ("auto", "ask", "off"):
        raise InstallError(f"update_mode must be auto, ask or off, not {s['update_mode']!r}")
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", s["variant"]):
        raise InstallError(f"bad variant {s['variant']!r}")
    if s["user"] and not re.fullmatch(r"[a-z_][a-z0-9_-]*", s["user"]):
        raise InstallError(f"bad user {s['user']!r}")
    for k in ("moode", "panel_optional"):
        if s[k].lower() not in ("yes", "no", "true", "false", "1", "0", "on", "off"):
            raise InstallError(f"{k} must be yes or no")
        s[k] = "yes" if s[k].lower() in ("yes", "true", "1", "on") else "no"
    if s["update_url"] and not re.fullmatch(r"(https?|file)://\S+", s["update_url"]):
        raise InstallError("update_url must be an http(s):// or file:// URL")
    return s


def box_yaml(s: dict, box_id: str | None = None) -> str:
    """A new radio's /etc/hasler/box.yaml (config/box.yaml.example)."""
    lines = [
        "# This Hasler's own settings (docs/ota.md section 1). Updates never touch",
        "# this file; config/box.yaml.example in the release documents every key.",
        "# Written by hasler-install for a new radio.",
        "schema: 1",
        f"variant: {s['variant']}",
        f"channel: {s['channel']}",
        f"update_mode: {s['update_mode']}",
        f"box_id: {box_id or uuid.uuid4()}",
        "checkin: false",
        "metered: false",
        # 001 moves an old rsync'd checkout; a new radio has none.
        "migrations: [001_from_rsync_tree]",
    ]
    if s["update_url"]:
        lines.append(f"update_url: {s['update_url']}   # makers: a local channel; remove for the public one")
    return "\n".join(lines) + "\n"


# --- the box steps (root, on the Pi) ---------------------------------------------------------

def run(argv: list[str], **kw) -> None:
    say("$ " + " ".join(argv))
    proc = subprocess.run(argv, **kw)
    if proc.returncode != 0:
        raise InstallError(f"{argv[0]} {' '.join(argv[1:3])} failed (exit {proc.returncode})")


def mark(name: str) -> Path:
    return STATE / name


def daemon_user(s: dict) -> str:
    import pwd
    if s["user"]:
        try:
            pwd.getpwnam(s["user"])
        except KeyError as e:
            raise NotYet(f"no user {s['user']!r} yet (Raspberry Pi Imager's first boot makes it)") from e
        return s["user"]
    try:
        return pwd.getpwuid(1000).pw_name
    except KeyError as e:
        raise NotYet("no login user yet (uid 1000)") from e


def moode_ready() -> bool:
    """moOde's worker has finished this boot (it truncates its log at start)."""
    if not Path("/var/www/daemon/worker.php").exists():
        return True                       # not moOde: nothing to wait for
    try:
        return "Startup complete" in MOODE_LOG.read_text(errors="replace")
    except OSError:
        return False


def wait_for(what: str, ok, timeout_s: float, step_s: float = 5) -> None:
    end = time.time() + timeout_s
    while not ok():
        if time.time() > end:
            raise NotYet(f"still waiting for {what}")
        time.sleep(step_s)


def online(base: str) -> bool:
    host = urllib.parse.urlparse(base).hostname
    if not host:
        return True
    import socket
    try:
        socket.getaddrinfo(host, 443)
        return True
    except OSError:
        return False


def write_owned(path: Path, text: str, user: str, mode: int = 0o644) -> None:
    import pwd
    pw = pwd.getpwnam(user)
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(text, encoding="utf-8")
    os.chmod(tmp, mode)
    os.chown(tmp, pw.pw_uid, pw.pw_gid)
    os.replace(tmp, path)


def step_setup(s: dict, args) -> dict:
    """Pass 1: verify + unpack, box setup, updater + trust, box.yaml, moOde settings."""
    user = daemon_user(s)
    wait_for("moOde to finish starting", moode_ready, 600)
    wait_for("the network", lambda: online(args.base), 600)
    for tool in ("zstd", "ssh-keygen"):
        if not shutil.which(tool):
            run(["apt-get", "update", "-q"])
            run(["apt-get", "install", "-y", "-q", "--no-install-recommends", "zstd", "openssh-client"])
            break
    got = fetch_release(args.base, s["channel"], STATE / "work", args.root_pubs)
    problems = compat_problems(got["release"], facts(), s["variant"])
    if problems:
        raise InstallError("this machine can't run the release: " + "; ".join(problems))
    setup: Path = got["setup"]
    if not mark("apt-updated").exists():
        run(["apt-get", "update", "-q"])
        mark("apt-updated").touch()
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    run(["bash", str(setup / "scripts/bootstrap.sh"), "--user", user], env=env)
    run(["bash", str(setup / "scripts/ota-bootstrap.sh"), "--user", user, "--trust", str(got["trust"])], env=env)
    box = Path("/etc/hasler/box.yaml")
    if not box.exists():
        write_owned(box, box_yaml(s), user)
        say(f"wrote {box} (channel {s['channel']}, update_mode {s['update_mode']})")
    else:
        say(f"{box} exists - kept as it is")
    if s["panel_optional"] == "yes":
        ov = Path(f"/etc/hasler/variant.d/{s['variant']}.yaml")
        if not ov.exists():
            write_owned(ov, "schema: 1\ncontrols: {}\nio: {panel_optional: true}   # hasler.txt panel_optional\n", user)
            say(f"wrote {ov}: the radio may run without its key board (a bare Pi)")
    run(["bash", str(setup / "scripts/ota-bootstrap.sh"), "--user", user], env=env)   # ownership after box.yaml
    reboot = False
    if s["moode"] == "yes" and not mark("moode-handed").exists():
        shutil.copyfile(setup / "config/firstboot/moodecfg.ini", MOODE_CFG)
        os.sync()
        mark("moode-handed").touch()
        say(f"moOde settings in {MOODE_CFG}: moOde applies them at the next start, then restarts once more")
        reboot = True
    mark("setup.done").write_text(json.dumps({"version": got["version"], "seq": got["seq"], "user": user}))
    return {"reboot": reboot, **{k: got[k] for k in ("version", "seq")}}


def updater_status() -> dict:
    try:
        out = subprocess.run(["/usr/local/sbin/hasler-update", "status"], capture_output=True, text=True,
                             timeout=60).stdout
        return json.loads(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return {}


def _staged() -> str | None:
    try:
        return json.loads(Path("/var/lib/hasler-update/status.json").read_text()).get("staged")
    except (OSError, ValueError):
        return None


def step_release(s: dict, args) -> str:
    """Pass 2: the release's updater stages and installs the release (a reboot into its trial)."""
    st = updater_status()
    phase = (st.get("state") or {}).get("phase")
    if (st.get("installed") or {}).get("version") and phase in ("probation", "committed", "idle"):
        return "installed"
    if phase == "trial":
        raise NotYet("the release is on trial (the updater judges it after this boot)")
    if phase == "rolled_back":
        raise InstallError("the release failed its health check and was rolled back: "
                           f"{(st.get('state') or {}).get('reason')} - see `hasler-update status`")
    wait_for("moOde to finish starting", moode_ready, 600)
    if MOODE_CFG.exists() and mark("moode-handed").exists():
        say(f"warning: {MOODE_CFG} is still there - moOde did not apply it; check /var/log/moode_autocfg.log")
    wait_for("the network", lambda: online(args.base), 600)
    run(["systemctl", "start", "hasler-update-check.service"])
    if s["update_mode"] == "off" and not _staged():
        # mode off stages nothing on its own; the first install is asked for
        run(["runuser", "-u", "hasler-update", "--", "/usr/bin/python3", "-I",
             "/usr/local/sbin/hasler-update", "check", "--stage", "--force"])
    try:
        status = json.loads(Path("/var/lib/hasler-update/status.json").read_text())
    except (OSError, ValueError) as e:
        raise NotYet("no update status yet") from e
    staged = status.get("staged")
    if not staged:
        raise NotYet(f"nothing staged yet: {status.get('message')}")
    seq = int(Path(staged).name)
    say(f"staged {status.get('available', {}).get('version')} (seq {seq}): installing - the radio restarts into it")
    mark("apply.started").touch()
    run(["/usr/local/sbin/hasler-update", "apply", "--seq", str(seq), "--force", "--allow-reboot"])
    # With a config.txt change the updater restarts the Pi into the trial (this
    # service carries on after that boot); without one it has judged it already.
    st = updater_status()
    if (st.get("installed") or {}).get("version") and (st.get("state") or {}).get("phase") in ("probation", "committed"):
        return "installed"
    return "applying"


def finish() -> None:
    mark("done").write_text(time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()) + "\n")
    subprocess.run(["systemctl", "disable", "--quiet", "hasler-install.service"], check=False)
    say("done: the radio runs its signed release and updates itself from now on")
    say("next, by hand (docs/new-install.md, 'After the install'): volume ceiling, Spotify login, "
        "YouTube Music sign-in, Home Assistant, knob calibration")


def resume(args) -> int:
    if os.geteuid() != 0:
        raise SystemExit("hasler-install resume: run as root")
    STATE.mkdir(parents=True, exist_ok=True, mode=0o755)
    if mark("done").exists():
        say("already installed")
        return 0
    s = settings_for(args)
    if not mark("setup.done").exists():
        out = step_setup(s, args)
        if out["reboot"]:
            say("restarting so moOde can take its settings")
            subprocess.run(["systemctl", "reboot"], check=False)
            return 0
    result = step_release(s, args)
    if result == "installed":
        finish()
    return 0


def settings_for(args) -> dict:
    saved = mark("settings.json")
    if saved.exists():
        s = json.loads(saved.read_text())
    else:
        s = read_settings(Path(args.settings))
        for k in ("channel", "user", "variant"):
            if getattr(args, k, None):
                s[k] = getattr(args, k)
        if getattr(args, "panel_optional", False):
            s["panel_optional"] = "yes"
        if getattr(args, "no_moode", False):
            s["moode"] = "no"
        s = validate(s)
        saved.write_text(json.dumps(s, indent=1) + "\n")
    if s.get("update_url") and args.base == BASE:
        args.base = s["update_url"]
    return s


def install_unit() -> None:
    if Path(sys.argv[0]).resolve() != SELF:
        shutil.copyfile(Path(sys.argv[0]).resolve(), SELF)
        SELF.chmod(0o755)
    UNIT.write_text(UNIT_TEXT)
    subprocess.run(["systemctl", "daemon-reload"], check=False)
    subprocess.run(["systemctl", "enable", "--quiet", "hasler-install.service"], check=False)


def hook(args) -> int:
    """cloud-init vendor-data, first boot: copy this file in and start the service."""
    if os.geteuid() != 0:
        raise SystemExit("hasler-install hook: run as root")
    STATE.mkdir(parents=True, exist_ok=True, mode=0o755)
    if mark("done").exists():
        return 0
    install_unit()
    subprocess.run(["systemctl", "start", "--no-block", "hasler-install.service"], check=False)
    say("first boot: hasler-install.service will set the radio up (about 15 minutes, a few restarts)")
    return 0


def install(args) -> int:
    """The SSH path: same steps as the first boot, started by hand."""
    if os.geteuid() != 0:
        raise SystemExit("hasler-install install: run as root (sudo)")
    if Path("/opt/hasler/current").is_symlink() and not mark("setup.done").exists():
        raise InstallError("this radio already runs a release - it updates itself (hasler-update status)")
    STATE.mkdir(parents=True, exist_ok=True, mode=0o755)
    s = settings_for(args)
    say(f"installing Hasler: channel {s['channel']}, variant {s['variant']}, "
        f"moOde settings {'yes' if s['moode'] == 'yes' else 'no'}")
    if not args.yes and sys.stdin.isatty():
        if input("Go ahead? It installs packages and restarts the Pi 2-3 times. [y/N] ").strip().lower() != "y":
            return 1
    install_unit()          # finishes the install after each restart
    return resume(args)


def status(_args) -> int:
    marks = sorted(p.name for p in STATE.glob("*") if p.is_file()) if STATE.is_dir() else []
    print(json.dumps({"state_dir": str(STATE), "marks": marks,
                      "updater": updater_status() if Path("/usr/local/sbin/hasler-update").exists() else None},
                     indent=2, default=str))
    return 0


def fetch_cmd(args) -> int:
    got = fetch_release(args.base, args.channel or "stable", Path(args.out), args.root_pubs)
    problems = compat_problems(got["release"], facts(), None)
    print(json.dumps({"version": got["version"], "seq": got["seq"], "tree": str(got["root"]),
                      "setup": str(got["setup"]), "trust": str(got["trust"]),
                      "compat_here": problems or "ok"}, indent=2))
    return 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="hasler-install", description=__doc__.split("\n")[0])
    ap.add_argument("--base", default=BASE, help="release site (default: the public channel)")
    ap.add_argument("--root-pub", action="append", help="root public key file (default: the pinned Hasler root)")
    ap.add_argument("--settings", default=str(SETTINGS), help="hasler.txt (default on the SD card)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    f = sub.add_parser("fetch")
    f.add_argument("--out", required=True)
    f.add_argument("--channel", choices=CHANNELS)
    i = sub.add_parser("install")
    i.add_argument("--channel", choices=CHANNELS)
    i.add_argument("--user")
    i.add_argument("--variant")
    i.add_argument("--panel-optional", action="store_true")
    i.add_argument("--no-moode", action="store_true")
    i.add_argument("--yes", "-y", action="store_true")
    sub.add_parser("resume")
    sub.add_parser("hook")
    sub.add_parser("status")
    args = ap.parse_args(argv)
    args.root_pubs = [Path(p).read_text().strip() for p in args.root_pub] if args.root_pub else [ROOT_PUB]
    try:
        return {"fetch": fetch_cmd, "install": install, "resume": resume, "hook": hook, "status": status}[args.cmd](args)
    except NotYet as e:
        say(f"not yet: {e} (tries again)")
        return EX_LATER
    except InstallError as e:
        say(f"error: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
