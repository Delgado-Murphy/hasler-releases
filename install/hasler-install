class InstallError(Exception):
    """Something is wrong and needs a person. The message says what."""


class NotYet(Exception):
    """Waiting for something (network, moOde, a reboot); try again later."""


# --- output ---------------------------------------------------------------------

def say(msg: str) -> None:
    line = f"hasler-install: {msg}"
    print(line, flush=True)
    if os.geteuid() == 0 and LOG_ON_CARD.parent.is_dir() and not os.environ.get("HASLER_INSTALL_NO_CARD_LOG"):
        try:
            with open(LOG_ON_CARD, "a", encoding="utf-8") as f:
                f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")
        except OSError:
            pass


# --- fetching -----------------------------------------------------------------------

def _open(url: str, allowed: set[str]):
    scheme = urllib.parse.urlparse(url).scheme
    if scheme not in allowed:
        raise InstallError(f"refusing {url}: scheme {scheme!r} (allowed: {', '.join(sorted(allowed))})")
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        return urllib.request.urlopen(req, timeout=TIMEOUT_S)  # noqa: S310 - checked below by signature/hash
    except urllib.error.HTTPError as e:
        if e.code == 404:
            raise InstallError(f"{url}: not found (404)") from e
        raise NotYet(f"{url}: {e}") from e
    except urllib.error.URLError as e:
        if isinstance(e.reason, FileNotFoundError):
            raise InstallError(f"{url}: not found (404)") from e
        raise NotYet(f"{url}: {e}") from e
    except (OSError, ValueError) as e:
        raise NotYet(f"{url}: {e}") from e


def get_small(url: str, allowed: set[str]) -> bytes:
    with _open(url, allowed) as r:
        data = r.read(SMALL_MAX + 1)
    if len(data) > SMALL_MAX:
        raise InstallError(f"{url}: larger than {SMALL_MAX} bytes")
    return data


def download(url: str, dest: Path, sha256: str, size: int | None, allowed: set[str]) -> Path:
    if dest.exists() and sha256_file(dest) == sha256:
        return dest
    dest.parent.mkdir(parents=True, exist_ok=True)
    part = dest.with_name(dest.name + ".part")
    got = 0
    with _open(url, allowed) as r, open(part, "wb") as f:
        while chunk := r.read(1 << 16):
            got += len(chunk)
            if size is not None and got > size:
                f.close()
                part.unlink()
                raise InstallError(f"{url}: more than the signed {size} bytes - refused")
            f.write(chunk)
    if sha256_file(part) != sha256:
        part.unlink()
        raise InstallError(f"{dest.name}: SHA-256 does not match the signed release.json - refused")
    os.replace(part, dest)
    return dest


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


# --- verification (the same contract as update/hasler_update/verify.py) -----------------
# A small copy on purpose: this runs before any release code may run. The
# release's own updater verifies everything again when it stages the release.
# update/tests/test_hasler_install.py keeps the two in step.

_PUB_RE = re.compile(r"^(ssh-ed25519|sk-ssh-ed25519@openssh\.com|ecdsa-sha2-nistp256|"
                     r"sk-ecdsa-sha2-nistp256@openssh\.com|ssh-rsa) [A-Za-z0-9+/=]+$")


def parse_iso(s: str) -> float:
    from datetime import datetime, timezone
    s = s.strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    dt = datetime.fromisoformat(s)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.timestamp()


def clean_pub(pub: str) -> str:
    parts = pub.strip().split()
    if len(parts) < 2 or not _PUB_RE.match(f"{parts[0]} {parts[1]}"):
        raise InstallError("malformed or unsupported public key")
    return f"{parts[0]} {parts[1]}"


def ssh_verify(data: bytes, sig: bytes, signers: list[tuple[str, str]], namespace: str) -> str:
    exe = shutil.which("ssh-keygen") or "/usr/bin/ssh-keygen"
    if not os.path.exists(exe):
        raise InstallError("ssh-keygen not found (apt-get install openssh-client)")
    if not signers:
        raise InstallError(f"no usable keys for {namespace}")
    with tempfile.TemporaryDirectory(prefix="hasler-install-") as tmp:
        sig_path = Path(tmp) / "data.sig"
        sig_path.write_bytes(sig)
        for key_id, pub in signers:
            if not re.fullmatch(r"[A-Za-z0-9._-]+", key_id):
                raise InstallError(f"bad key id {key_id!r}")
            allowed = Path(tmp) / "allowed_signers"
            allowed.write_text(f'{key_id} namespaces="{namespace}" {clean_pub(pub)}\n')
            proc = subprocess.run([exe, "-Y", "verify", "-f", str(allowed), "-I", key_id, "-n", namespace,
                                   "-s", str(sig_path)], input=data, capture_output=True, timeout=30)
            if proc.returncode == 0:
                return key_id
    raise InstallError(f"bad signature ({namespace}) - refused")


def _not_expired(doc: dict, now: float, what: str) -> None:
    try:
        exp = parse_iso(str(doc["expires"]))
    except (KeyError, ValueError) as e:
        raise InstallError(f"{what}: no valid 'expires'") from e
    if now >= exp:
        raise InstallError(f"{what} expired at {doc['expires']} (is the clock right? `date -u`)")


def verify_keyring(data: bytes, sig: bytes, root_pubs: list[str], now: float) -> dict:
    ssh_verify(data, sig, [(f"root{i}", p) for i, p in enumerate(root_pubs)], NS_KEYRING)
    doc = json.loads(data)
    if doc.get("schema") != 1 or not isinstance(doc.get("keys"), list):
        raise InstallError("keyring: unknown schema")
    _not_expired(doc, now, "keyring")
    return doc


def signers(ring: dict, role: str, now: float) -> list[tuple[str, str]]:
    out = []
    for k in ring["keys"]:
        try:
            if k.get("role") == role and now < parse_iso(str(k["not_after"])):
                out.append((str(k["id"]), str(k["pub"])))
        except (KeyError, ValueError):
            continue
    return out


def verify_index(data: bytes, sig: bytes, ring: dict, channel: str, now: float) -> dict:
    ssh_verify(data, sig, signers(ring, "timestamp", now), NS_INDEX)
    doc = json.loads(data)
    if doc.get("schema") != 1:
        raise InstallError("channel index: unknown schema")
    if doc.get("channel") != channel:
        raise InstallError(f"channel index is for {doc.get('channel')!r}, not {channel!r}")
    _not_expired(doc, now, "channel index")
    if parse_iso(str(doc["issued"])) > now + CLOCK_SKEW_S:
        raise InstallError("channel index issued in the future (is the clock right?)")
    cur = doc.get("current")
    if not isinstance(cur, dict) or not {"version", "seq", "release_url", "release_sha256"} <= cur.keys():
        raise InstallError("channel index: no current release")
    if int(cur["seq"]) in (doc.get("halted") or []):
        raise InstallError(f"the channel's current release {cur['version']} is halted")
    return doc


def verify_release(data: bytes, sig: bytes, ring: dict, index: dict, now: float) -> dict:
    cur = index["current"]
    if hashlib.sha256(data).hexdigest() != cur["release_sha256"]:
        raise InstallError("release.json does not match the channel index - refused")
    ssh_verify(data, sig, signers(ring, "release", now), NS_RELEASE)
    doc = json.loads(data)
    if doc.get("schema") != 1 or doc.get("product") != "hasler":
        raise InstallError("release.json: wrong schema or product")
    if int(doc["seq"]) != int(cur["seq"]) or str(doc["version"]) != str(cur["version"]):
        raise InstallError("release.json does not match the channel index")
    if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?", str(doc["version"])):
        raise InstallError(f"release.json: bad version {doc['version']!r}")
    arts = doc.get("artifacts")
    if not isinstance(arts, list) or not arts or not re.fullmatch(r"[0-9a-f]{64}", str(arts[0].get("sha256", ""))):
        raise InstallError("release.json: no artifact sha256")
    _not_expired(doc, now, f"release {doc['version']}")
    if int(doc.get("keyring_seq", 0)) > int(ring["keyring_seq"]):
        raise InstallError("release needs a newer keyring than the published one")
    return doc


def facts() -> dict:
    codename = None
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            if line.startswith("VERSION_CODENAME="):
                codename = line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    moode = None
    if shutil.which("moodeutl"):
        try:
            out = subprocess.run(["moodeutl", "--mooderel"], capture_output=True, text=True, timeout=20).stdout
            m = re.search(r"\d+\.\d+(\.\d+)?", out)
            moode = m.group(0) if m else None
        except (OSError, subprocess.SubprocessError):
            pass
    abi = None
    if os.path.exists("/usr/bin/python3"):
        tag = subprocess.run(["/usr/bin/python3", "-c", "import sys;print(sys.implementation.cache_tag)"],
                             capture_output=True, text=True).stdout.strip()
        m = re.fullmatch(r"cpython-(\d+)", tag)
        abi = f"cp{m.group(1)}" if m else None
    return {"arch": platform.machine(), "os": codename, "moode": moode, "python_abi": abi}


def _vt(v: str) -> tuple:
    nums = [int(n) for n in re.findall(r"\d+", v.split("-")[0])[:3]]
    return tuple(nums + [0] * (3 - len(nums)))


def compat_problems(release: dict, have: dict, variant: str | None) -> list[str]:
    req, out = release.get("requires") or {}, []
    for key in ("arch", "os", "python_abi"):
        if req.get(key) and have.get(key) != req[key] and not (key == "python_abi" and release.get("bundles_python")):
            out.append(f"needs {key} {req[key]}, this machine has {have.get(key)}")
    if req.get("moode"):
        if not have.get("moode"):
            out.append(f"needs moOde {req['moode']}, moOde not found")
        else:
            for part in (p.strip() for p in str(req["moode"]).split(",") if p.strip()):
                m = re.fullmatch(r"(>=|<=|==|>|<)?\s*([0-9.]+)", part)
                if m:
                    op, v, h = m.group(1) or "==", _vt(m.group(2)), _vt(have["moode"])
                    ok = {">=": h >= v, "<=": h <= v, "==": h == v, ">": h > v, "<": h < v}[op]
                    if not ok:
                        out.append(f"needs moOde {req['moode']}, this is {have['moode']}")
    if variant and release.get("variants") and variant not in release["variants"]:
        out.append(f"release does not ship variant {variant!r}")
    return out


# --- unpacking ------------------------------------------------------------------------

def _decompressor(path: Path) -> list[str] | None:
    head = path.open("rb").read(6)
    if head[:4] == b"\x28\xb5\x2f\xfd":
        if not shutil.which("zstd"):
            raise InstallError("zstd not found (apt-get install zstd)")
        return ["zstd", "-q", "-dc", str(path)]
    return None   # tar or tar.gz: tarfile reads them itself


def unpack(tarball: Path, dest: Path, files_sha256: str | None) -> Path:
    """Extract (data filter: no links out, no devices, no setuid), then check every
    file against files.sha256 inside. Returns the release root hasler-<v>/."""
    if dest.exists():
        shutil.rmtree(dest)
    dest.mkdir(parents=True)
    cmd = _decompressor(tarball)
    if cmd:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE)
        tf = tarfile.open(fileobj=proc.stdout, mode="r|")
    else:
        proc, tf = None, tarfile.open(tarball, mode="r:*")
    tops = set()
    with tf:
        for member in tf:
            name = member.name
            if name.startswith("/") or ".." in Path(name).parts:
                raise InstallError(f"tarball: unsafe path {name!r}")
            tops.add(Path(name).parts[0])
            if member.issym() or member.islnk():
                raise InstallError(f"tarball: link {name!r} - releases have none")
            tf.extract(member, dest, filter="data")
    if proc and proc.wait() != 0:
        raise InstallError("zstd could not decompress the release")
    if len(tops) != 1:
        raise InstallError(f"tarball: expected one top directory, found {sorted(tops)}")
    root = dest / tops.pop()
    listing = (root / "files.sha256").read_bytes()
    if files_sha256 and hashlib.sha256(listing).hexdigest() != files_sha256:
        raise InstallError("files.sha256 does not match release.json")
    listed = set()
    for line in listing.decode().splitlines():
        if not line.strip():
            continue
        digest, _mode, rel = line.split(None, 2)
        p = root / rel
        listed.add(rel)
        if not p.is_file() or sha256_file(p) != digest:
            raise InstallError(f"{rel}: does not match files.sha256 - refused")
    for p in root.rglob("*"):
        rel = p.relative_to(root).as_posix()
        if p.is_file() and rel != "files.sha256" and rel not in listed:
            raise InstallError(f"{rel}: in the tarball but not in files.sha256 - refused")
    return root


